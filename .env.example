MAILBRIDGE_APP_NAME=mailbridge
MAILBRIDGE_ENVIRONMENT=development
MAILBRIDGE_DATABASE_URL=sqlite+pysqlite:///./mailbridge.db
MAILBRIDGE_IMAP_HOST=imap.example.com
MAILBRIDGE_IMAP_PORT=993
MAILBRIDGE_IMAP_USERNAME=username
MAILBRIDGE_IMAP_PASSWORD=password
MAILBRIDGE_IMAP_USE_SSL=true
MAILBRIDGE_TELEGRAM_TOKEN=
MAILBRIDGE_TELEGRAM_CHAT_ID=
MAILBRIDGE_MATTERMOST_WEBHOOK_URL=
MAILBRIDGE_WORKER_POLL_INTERVAL_SECONDS=30
MAILBRIDGE_METRICS_ENABLED=true
MAILBRIDGE_METRICS_PATH=/metrics
MAILBRIDGE_SECRET_KEY=please-change
